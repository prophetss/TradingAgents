# ntfy bridge settings. Install as ~/.tradingagents/ntfy-bridge/env with mode 600:
#   install -m 600 -D ntfy_bridge/systemd/env.example ~/.tradingagents/ntfy-bridge/env

# --- required ---------------------------------------------------------------
# Two hard-to-guess topics: commands in, results out. Treat them as passwords.
NTFY_COMMAND_TOPIC=ta_cmd_replace_with_random_suffix
NTFY_RESULT_TOPIC=ta_res_replace_with_random_suffix

# --- optional: server / auth ------------------------------------------------
# NTFY_SERVER=https://ntfy.sh
# Access token (self-hosted ACL, or ntfy Pro). Also used for subscribing.
# NTFY_TOKEN=tk_replace_me

# When set, every command must start with this value (or carry secret=...).
# Without it, anyone who knows the command topic can start analyses.
NTFY_COMMAND_SECRET=replace_with_a_long_random_value

# --- optional: budgets and pacing -------------------------------------------
# NTFY_DAILY_JOB_LIMIT=10
# NTFY_QUEUE_LIMIT=10
# NTFY_JOB_TIMEOUT=1800
# NTFY_MIN_JOB_GAP=30
# NTFY_RATE_LIMIT_BACKOFF=600
# NTFY_REPLAY_MAX_AGE=3600
# NTFY_RETENTION_DAYS=14
# NTFY_HEARTBEAT_HOUR=9
# NTFY_POLL_INTERVAL=5
# NTFY_COUNT_FAILED=1

# --- optional: analysis defaults --------------------------------------------
# Passed to the CLI unless the command carries language=...
# NTFY_OUTPUT_LANGUAGE=Chinese
# NTFY_TITLE_PREFIX=

# --- optional: locations ----------------------------------------------------
# NTFY_BRIDGE_HOME=~/.tradingagents/ntfy-bridge
# NTFY_BRIDGE_REPO=/home/w/文档/x/TradingAgents-akshare
# NTFY_CLI=/home/w/文档/x/TradingAgents-akshare/.venv/bin/tradingagents
# NTFY_BRANCH=main

# --- optional: logging ------------------------------------------------------
# NTFY_LOG_LEVEL=INFO
